# Copy to .env for local development. Never commit real values.
# All backend settings use the VBALL_ prefix (see packages/vball_core/src/vball_core/settings.py).

VBALL_ENV=local
VBALL_LOG_LEVEL=INFO
VBALL_LOG_JSON=false

# Local compose stack (infra/docker/compose.yaml). Production: Supabase connection string.
VBALL_DATABASE_URL=postgresql+psycopg://vball:vball-local-only@localhost:5432/vball
VBALL_CORS_ORIGINS=http://localhost:3000

# Supabase project URL (Project Settings > API). The API verifies sign-in tokens against
# <url>/auth/v1/.well-known/jwks.json, so the project must use asymmetric JWT signing keys.
VBALL_SUPABASE_URL=

# Object storage. Local compose sets these for the API container itself. For Cloudflare R2:
# VBALL_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# VBALL_S3_ACCESS_KEY_ID / VBALL_S3_SECRET_ACCESS_KEY from an R2 API token (Object Read & Write,
# limited to the bucket), VBALL_S3_BUCKET=vball

# Tests: S3 server for upload tests (the local SeaweedFS container)
VBALL_TEST_S3_ENDPOINT=http://localhost:8333
VBALL_TEST_S3_KEY=vball-local
VBALL_TEST_S3_SECRET=vball-local-only-secret

# Tests create throwaway databases through this admin connection.
VBALL_TEST_DATABASE_URL=postgresql+psycopg://vball:vball-local-only@localhost:5432/postgres

# Web app: put these in apps/web/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (sb_publishable_...) is safe in the browser. Never use the secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
