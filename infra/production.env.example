# Production settings (copy to infra/production.env; that file is git-ignored). Used by the
# Vercel API project (all lines), the GitHub Actions worker (repository secrets) and local
# one-off commands (migrations, model publish). See docs/DEPLOY.md.
VBALL_ENV=production
VBALL_LOG_JSON=true

# Supabase > Connect > Session pooler, with postgresql+psycopg:// and your DB password
VBALL_DATABASE_URL=postgresql+psycopg://postgres.hkfzpbzivnnwspckzjbi:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
VBALL_SUPABASE_URL=https://hkfzpbzivnnwspckzjbi.supabase.co

# Web app URL on Vercel (after its first deploy), comma-separated if several
VBALL_CORS_ORIGINS=https://YOUR-WEB-APP.vercel.app

# Backblaze B2: bucket endpoint with https://; region = the part after "s3."
VBALL_S3_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
VBALL_S3_REGION=us-west-004
VBALL_S3_BUCKET=vball-CHANGE-ME
VBALL_S3_ACCESS_KEY_ID=
VBALL_S3_SECRET_ACCESS_KEY=

# B2 free tier is 10 GB: keep stored videos under ~9 GB
VBALL_STORAGE_CAP_BYTES=9000000000

# API starts the GitHub Actions worker (fine-grained token: vball-ai, Contents read/write)
VBALL_WORKER_DISPATCH_REPO=martinzukowski/vball-ai
VBALL_WORKER_DISPATCH_TOKEN=
